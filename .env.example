# ── OpenSea ─────────────────────────────────────────────────────────────
# Get a key at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key_here
OPENSEA_API_BASE=https://api.opensea.io
# Max requests/sec sent to OpenSea. Stay within your plan's rate limit.
OPENSEA_RPS=4
OPENSEA_TIMEOUT_MS=8000

# ── Wallet (HOT WALLET — see README warnings) ───────────────────────────
# 0x-prefixed 32-byte hex. NEVER commit a real key. Leave empty for
# keyless dry-run simulations.
PRIVATE_KEY=
# Address used for balance/eligibility checks in dry-run when no key is set.
MINTER_ADDRESS=
#
# Named wallets — one per client when their wallet pays for their mints.
# PRIVATE_KEY_<NAME>=0x... registers wallet "<name>" (lowercased); a
# strategy selects it with `wallet: "<name>"`. PRIVATE_KEY is "default".
# PRIVATE_KEY_ALICE=0x...
# PRIVATE_KEY_BOB=0x...

# ── RPC endpoints (comma-separated for failover, per chain) ─────────────
# Any OpenSea-supported EVM chain works — the variable name is
# RPC_<CHAIN_NAME_UPPERCASE>. Unset chains fall back to public RPCs.
# Major chains:
RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY,https://mainnet.infura.io/v3/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_POLYGON=
RPC_ARBITRUM=
RPC_ARBITRUM_NOVA=
RPC_OPTIMISM=
RPC_AVALANCHE=
RPC_BSC=
RPC_BLAST=
RPC_ZORA=
RPC_SEI=
RPC_APE_CHAIN=
RPC_ABSTRACT=
RPC_BERACHAIN=
RPC_MONAD=
RPC_UNICHAIN=
RPC_RONIN=
RPC_FLOW_EVM=
RPC_SOMNIA=
RPC_HYPER_EVM=
RPC_SONEIUM=
RPC_INK=
RPC_SCROLL=
RPC_LINEA=
RPC_MANTLE=
RPC_TAIKO=
RPC_ZKSYNC=
RPC_SONIC=
RPC_WORLD_CHAIN=
RPC_SWELLCHAIN=
RPC_STORY=
RPC_GNOSIS=
RPC_CELO=
RPC_MOONBEAM=
RPC_FANTOM=
RPC_CRONOS=
RPC_ZETACHAIN=
RPC_BOBA=
RPC_KLAYTN=
RPC_MINT=
RPC_SHAPE=
RPC_MORPH=
RPC_GRAVITY=
RPC_B3=
RPC_GUNZ=
RPC_XAI=
RPC_CHILIZ=
RPC_CYBER=
RPC_LISK=
RPC_HEMI=
RPC_REDSTONE=
RPC_TREASURE=
RPC_DEGEN=
RPC_HAM=
RPC_ORDERLY=
RPC_SUPERPOSITION=
RPC_SANKO=
RPC_HYCHAIN=
RPC_ARENA_Z=
RPC_PLUME=
RPC_LUMIA=
RPC_FORM=
RPC_MODE=
RPC_FRAXTAL=
RPC_ZIRCUIT=
RPC_METIS=
RPC_OPBNB=
RPC_MANTA=
RPC_KROMA=
RPC_PALM=
RPC_POLYGON_ZKEVM=
RPC_X_LAYER=
RPC_XRP_EVM=
RPC_ROBINHOOD=
RPC_ROBINHOOD_TESTNET=
#
# WebSocket endpoints (WSS_<CHAIN>) — drives block-boundary broadcast
# timing and per-block speed-up. Same provider key as RPC_*, wss:// scheme.
# WSS_ROBINHOOD=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# WSS_ARC=wss://arc-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# Private relays (RELAY_<CHAIN>) — broadcast fan-out alongside public RPCs
# so the tx reaches builders/validators directly. e.g.
# RELAY_ETHEREUM=https://rpc.flashbots.net

# ── Safety ──────────────────────────────────────────────────────────────
# DRY_RUN=true runs the full pipeline but never broadcasts. KEEP true
# until you have validated everything.
DRY_RUN=true
# Engage to halt all execution immediately.
KILL_SWITCH=false
SIMULATE_BEFORE_SEND=true
MAX_SPEND_PER_TX_ETH=0.5
MAX_SPEND_PER_DAY_ETH=2
MAX_GAS_FEE_ETH=0.02
MAX_QUANTITY_PER_TX=10
CONFIRMATION_TIMEOUT_MS=120000
# % bump on estimated gas fees so your tx outbids competing mint bots.
# 0 = network estimate. 25-50 is typical for contested public mints.
# Still bounded by MAX_GAS_FEE_ETH.
PRIORITY_FEE_BUMP_PCT=0

# ── Snipe engine (contest-mint speed path) ──────────────────────────────
# Arms at SNIPER_ARM_MS before a stage's startTime (wall clock), tight-
# loops the build endpoint from SNIPER_BUILD_LEAD_MS out, pre-signs, and
# broadcasts at the exact start.
# SNIPER_ENABLED=true
# SNIPER_ARM_MS=10000
# SNIPER_BUILD_LEAD_MS=4000
# SNIPER_BUILD_INTERVAL_MS=120
# SNIPER_BUILD_TIMEOUT_MS=45000
# SNIPER_BROADCAST_LEAD_MS=0
# SNIPER_GAS_LIMIT=350000
# Extra % fee bump on snipe txs, on top of PRIORITY_FEE_BUMP_PCT.
# SNIPER_FEE_BUMP_PCT=0
# eth_call the snipe tx before broadcasting — skips a guaranteed revert.
# Adds one RPC round-trip to the hot path; false = maximum speed.
# SNIPER_SIMULATE=true
#
# Direct contract mint — build mint calldata locally for public stages,
# bypassing the OpenSea build round-trip entirely.
# DIRECT_MINT_ENABLED=true
# DIRECT_MINT_VALUE_PAD_PCT=0
#
# Stuck-tx speed-up — re-broadcast a same-nonce replacement with a bumped
# fee if a tx sits pending through a block.
# SPEEDUP_AFTER_MS=12000
# SPEEDUP_FEE_BUMP_PCT=15
# SPEEDUP_MAX=3

# ── Strategies ──────────────────────────────────────────────────────────
STRATEGIES_FILE=strategies.yaml
# Interactive setup wizard on startup (self/clients, paste an OpenSea
# link, see time + eligibility + funding, arm the mint). Only runs in an
# interactive terminal — set false for unattended runs.
ACO_WIZARD=true

# ── API server ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=*
LOG_LEVEL=info

# ── Notifications (optional) ────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Persistence (Phase 6; in-memory store is the Phase 1 default) ───────
DATABASE_URL=postgres://aco:aco@localhost:5432/aco
REDIS_URL=redis://localhost:6379
